{
  "name": "MangaShelf — Organizador y Lector Digital",
  "short_name": "MangaShelf",
  "description": "Organizador de biblioteca y lector digital de manga y cómic con soporte sin conexión (Demo PWA).",
  "lang": "es-ES",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
